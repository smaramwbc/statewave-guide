{
  "name": "statewave-guide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Memory-powered, code-aware, interactive application guidance.",
  "license": "Apache-2.0",
  "author": "Statewave <hello@statewave.ai>",
  "homepage": "https://statewave.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/smaramwbc/statewave-guide.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:example": "pnpm --filter @statewavedev/guide-react-demo build",
    "clean": "pnpm -r exec rm -rf dist .turbo && rm -rf node_modules/.cache",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:example": "pnpm --filter @statewavedev/guide-react-demo dev",
    "index:example": "pnpm --filter @statewavedev/guide-react-demo guide:index",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm format:check",
    "test:indexer-quality": "node scripts/indexer-quality.mjs",
    "test:indexer-perf": "node scripts/indexer-perf.mjs",
    "test:indexer-quality:diff": "node scripts/benchmark-diff.mjs docs/benchmarks/pre-fix.json docs/benchmarks/post-fix.json",
    "test:semantic-quality": "node scripts/semantic-quality.mjs",
    "benchmark:providers": "node scripts/benchmark-providers.mjs",
    "benchmark:human-review": "node scripts/human-review-import.mjs",
    "benchmark:build-human-review": "node scripts/build-human-review.mjs",
    "test:guidance-quality": "node scripts/guidance-quality.mjs",
    "benchmark:guidance-snapshot": "node scripts/guidance-snapshot.mjs",
    "benchmark:build-human-review-3": "node scripts/build-human-review-3.mjs",
    "test:no-factual-expansion": "node scripts/guidance-snapshot.mjs",
    "test:workflow-selection-quality": "node scripts/workflow-selection-quality.mjs",
    "benchmark:round-3-vs-4": "node scripts/guidance-round-3-vs-4.mjs",
    "benchmark:build-human-review-4": "node scripts/build-human-review-4.mjs",
    "benchmark:round-4-vs-5": "node scripts/guidance-round-4-vs-5.mjs",
    "benchmark:build-human-review-5": "node scripts/build-human-review-5.mjs",
    "test:action-target-recovery-quality": "node scripts/action-target-recovery-quality.mjs",
    "benchmark:round-5-vs-6": "node scripts/guidance-round-5-vs-6.mjs",
    "benchmark:build-human-review-6": "node scripts/build-human-review-6.mjs",
    "test:semantic-language-authority-quality": "node scripts/semantic-language-authority-quality.mjs",
    "test:review-fact-coverage": "node scripts/build-human-review-6.mjs --check",
    "benchmark:round-6-vs-7": "node scripts/guidance-round-6-vs-7.mjs",
    "benchmark:build-human-review-7": "node scripts/build-human-review-7.mjs",
    "test:user-visible-label-quality": "node scripts/user-visible-label-quality.mjs",
    "test:title-authority-quality": "node scripts/title-authority-quality.mjs",
    "test:element-containment-quality": "node scripts/element-containment-quality.mjs",
    "test:review-action-fact-coverage": "node scripts/build-human-review-7.mjs --check",
    "test:artifact-integrity": "node scripts/historical-artifact-integrity.mjs",
    "test:tree-clean": "node scripts/tree-clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
